<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme._2hAuto"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:label="Chi tiết bài đăng" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="Trò chuyện"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChooseCategoryActivity"
            android:exported="false"
            android:label="Chọn danh mục" />
        <activity
            android:name=".CreatePostActivity"
            android:exported="false"
            android:label="Đăng tin" />
        <activity
            android:name=".CreateBikePostActivity"
            android:exported="false"
            android:label="Đăng tin xe đạp" />
        <activity
            android:name=".CreateMotoPostActivity"
            android:exported="false"
            android:label="Đăng tin xe máy" />
        <activity
            android:name=".CreateTruckPostActivity"
            android:exported="false"
            android:label="Đăng tin xe tải" />
        <activity
            android:name=".CreateElectricBikePostActivity"
            android:exported="false"
            android:label="Đăng tin xe điện" />
        <activity
            android:name=".CreateAccessoryPostActivity"
            android:exported="false"
            android:label="Đăng tin phụ kiện" />
        <activity
            android:name=".CreateBatteryPostActivity"
            android:exported="false"
            android:label="Đăng tin bình điện" />
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:label="Yêu thích" />
    </application>

</manifest>